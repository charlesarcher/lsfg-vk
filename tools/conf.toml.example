# Example lsfg-vk configuration file for one-way dual-GPU offload
# Place at ~/.config/lsfg-vk/conf.toml or point LSFGVK_CONFIG to this file.
version = 2

[global]
dll = "/mnt/windows/Games/Steam/steamapps/common/Lossless Scaling/Lossless.dll"
allow_fp16 = true

# ── App Offload Profile ───────────────────────────────────────────────────
[[profile]]
name = "app-oneway"
gpu = "AMD Radeon RX 9060 XT (RADV GFX1200)"
presentation = "external"
multiplier = 2
# transport omitted: cross-GPU default is decoupled. udmabuf is an explicit
# opt-in that stalls about 30 ms under load. Do not set it here.

# ── FurMark Game External Profile ─────────────────────────────────────────
[[profile]]
name = "furmark-oneway"
active_in = "furmark"
gpu = "AMD Radeon RX 9060 XT (RADV GFX1200)"
presentation = "external"
multiplier = 2
# transport omitted: cross-GPU default is decoupled. Do not set udmabuf.

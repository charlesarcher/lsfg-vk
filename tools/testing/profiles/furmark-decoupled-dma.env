# furmark-decoupled-dma
# Same run as furmark-decoupled-bench (FurMark fullscreen 1440p on the 9070,
# gpu-index 1, MangoHud, ImGui overlay, present on DP-7) but with
# transport = "decoupled" instead of the "udmabuf" bounce. A/B pair for the
# ~40 ms per-frame stall measured on 2026-10-11.
LSFG_CONFIG_NAME=furmark-decoupled-dma.toml
LSFG_MAX_TIME=60
LSFG_RECORD=0
APP_ENV=(
  LSFGVK_PRESENT_COUNT=1
  LSFGVK_COPY_TS=1
  LSFGVK_PRESENT_PACE=1
)
FM_ENV=()

# furmark-decoupled-dma-view
# Long enough to read the card at the display: same run as furmark-decoupled-dma,
# 3 minutes instead of 60 s, and no recorder stealing frames or disk.
LSFG_CONFIG_NAME=furmark-decoupled-dma.toml
LSFG_MAX_TIME=180
LSFG_RECORD=0
APP_ENV=(
  LSFGVK_PRESENT_COUNT=1
)
FM_ENV=()
export LSFG_RUN_ROOT=$HOME/lsfg-work/runs

# furmark-decoupled-colordump
# Same as the bench, plus one-frame color dumps at five frame ids spread
# across the 60 s run. The binary must honor LSFGVK_COLOR_DUMP_FIDXS.
LSFG_MAX_TIME=60
LSFG_RECORD=0
APP_ENV=(
  LSFGVK_COLOR_DUMP=1
  LSFGVK_COLOR_DUMP_FIDXS=80,2000,4000,6000,8000
)
FM_ENV=(
  LSFGVK_COLOR_DUMP=1
  LSFGVK_COLOR_DUMP_FIDXS=80,2000,4000,6000,8000
)

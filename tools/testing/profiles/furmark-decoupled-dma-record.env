# furmark-decoupled-dma-record
# The furmark-decoupled-dma run with a 240 fps DP-7 capture, so the doubled
# output can be checked in the pixels, not only in the counters.
LSFG_CONFIG_NAME=furmark-decoupled-dma.toml
LSFG_MAX_TIME=60
LSFG_RECORD=1
APP_ENV=(
  LSFGVK_PRESENT_COUNT=1
  LSFGVK_COPY_TS=1
  LSFGVK_PRESENT_PACE=1
)
FM_ENV=()
export LSFG_RUN_ROOT=$HOME/lsfg-work/runs

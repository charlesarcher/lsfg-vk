# re2-nolayer
# Same Steam launch as re2, with the layer disabled. Not a fix.
# Steam still calls tools/games/launch_re2.sh.
GAME_KIND=steam
STEAM_APPID=883710
GAME_COMM=re2.exe
LSFG_CONFIG_NAME=re2.toml
LSFGVK_PROFILE=re2-oneway
LAYER_ON=0
LSFGVK_MEASURE=0
LSFG_MAX_TIME=25
LSFG_RECORD=1
MESA_VK_DEVICE_SELECT=1002:7550
LSFGVK_LAYER_DBG=0
PROTON_LOG=0
DXVK_LOG_LEVEL=info
VKD3D_DEBUG=warn
APP_ENV=()
FM_ENV=()

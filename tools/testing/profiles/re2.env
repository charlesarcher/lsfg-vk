# re2
# Steam appid 883710. Steam's launch option is tools/games/launch_re2.sh.
# This profile does not replace that path. lsfg-launch.sh starts the appid,
# and Steam calls launch_re2.sh. LSFGVK_MEASURE=1 is for this measurement
# run. It is off unless this profile sets it.
GAME_KIND=steam
STEAM_APPID=883710
GAME_COMM=re2.exe
LSFG_CONFIG_NAME=re2.toml
LSFGVK_PROFILE=re2-oneway
LAYER_ON=1
export LSFGVK_MEASURE=1
LSFG_MAX_TIME=30
LSFG_RECORD=1
MESA_VK_DEVICE_SELECT=1002:7550
LSFGVK_LAYER_DBG=0
PROTON_LOG=0
DXVK_LOG_LEVEL=info
VKD3D_DEBUG=warn
# Test only. Show the doubler socket directory inside pressure-vessel.
# Not a permanent fix.
export PRESSURE_VESSEL_FILESYSTEMS_RW=/run/user/1000/lsfg-vk
APP_ENV=()
FM_ENV=()

# pair igpu-to-9060: game on Intel iGPU (ARL) -> doubling on RX 9060 XT
# FurMark picks its adapter by --gpu-index over the loader's enumeration order on this
# machine, which is 0 = RX 9060 XT, 1 = RX 9070 XT, 2 = Intel iGPU. MESA_VK_DEVICE_SELECT
# does not move FurMark's choice, so the index is the pin; every run checks the card the
# stream actually came from (lsfg-vk-app logs "stream from '<deviceName>'").
FM_GPU_INDEX=2
LSFG_CONFIG_NAME=pair-igpu-to-9060.toml
LSFG_MAX_TIME=60
LSFG_RECORD=1
FM_W=1280
FM_H=720
FM_MSAA=1
APP_ENV=(
  LSFGVK_PRESENT_COUNT=1
)
FM_ENV=()
export LSFG_RUN_ROOT=$HOME/lsfg-work/runs
